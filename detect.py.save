#!/usr/bin/env python3
"""
Blind assistance: TFLite object detection on Raspberry Pi with Marathi audio (espeak).
Run: python3 detect.py

Auto-start on boot (example, adjust paths):
  sudo nano /etc/systemd/system/blind-assist.service
  ---
  [Unit]
  Description=Blind Assistance Detection
  After=network.target sound.target

  [Service]
  Type=simple
  User=pi
  WorkingDirectory=/home/pi/OBJECT-DETECTION-PROJECT-main-main
  ExecStart=/usr/bin/python3 /home/pi/OBJECT-DETECTION-PROJECT-main-main/detect.py
  Restart=on-failure
  RestartSec=5

  [Install]
  WantedBy=multi-user.target
  ---
  sudo systemctl enable blind-assist.service && sudo systemctl start blind-assist.service
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import threading
import time
from collections import deque
from queue import Empty, Queue
from typing import Any, Dict, List, Optional, Tuple

import cv2
import numpy as np

# ---------------------------------------------------------------------------
# Configuration (tune for your camera / model)
# ---------------------------------------------------------------------------
MODEL_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "model", "detect.tflite")
LABEL_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "model", "labelmap.txt")
_MODEL_CANDIDATES = ("detect.tflite", "model.tflite", "efficientdet_lite0.tflite")

CONFIDENCE_THRESHOLD = 0.6
FOCAL_SCALE = 0.45
MIN_BBOX_PX = 8
# Ignore very small objects (reduces noise; tune per resolution)
MIN_BBOX_WIDTH_PX = 28

COOLDOWN_SEC = 3.0
DISTANCE_CHANGE_M = 0.6  # compared against smoothed distance

CAMERA_INDEX = 0
CAMERA_REOPEN_DELAY_SEC = 0.8
FRAME_STRIDE_DEFAULT = 2
# If FPS drops below this, process fewer frames (adaptive)
FPS_TARGET_LOW = 6.0
FPS_TARGET_HIGH = 12.0
ADAPTIVE_STRIDE_MAX = 4
# Re-evaluate stride only every N processed frames (avoids thrashing)
ADAPTIVE_CHECK_INTERVAL = 45

FPS_WINDOW = 30
LOG_EVERY_FRAMES = 10

# Rolling mean length for distance (reduces spoken jitter)
DISTANCE_SMOOTH_LEN = 3

# espeak
_ESPEAK_CMDS = (("espeak-ng",), ("espeak",))

# Priority: lower number = announce first (person > vehicles > others)
PRIORITY_PERSON = 0
PRIORITY_VEHICLE = 1
PRIORITY_OTHER = 2

VEHICLE_LABELS = frozenset(
    {
        "bicycle",
        "car",
        "motorcycle",
        "airplane",
        "bus",
        "train",
        "truck",
        "boat",
    }
)

